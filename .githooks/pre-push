#!/bin/sh
TARGET_NAME="greatColin"
TARGET_EMAIL="34583190+greatColin@users.noreply.github.com"
if [ "$(git config user.name)" != "$TARGET_NAME" ]; then
    echo "[coloop-git-check] user.name 应为 $TARGET_NAME，当前: $(git config user.name)" >&2
